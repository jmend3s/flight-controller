
&zephyr_udc0
{
	cdc_acm_uart0
	{
		compatible = "zephyr,cdc-acm-uart";
		label = "Zephyr USB CDC-ACM";
	};
};

/ {
    aliases
	{
        spitest = &spidev0;
    };
};

&lpspi1
{
    status = "okay";
 	cs-gpios = <&gpio2 0 GPIO_ACTIVE_LOW>;

	spidev0: spidev0@0
	{
		compatible = "zephyr,spidevtest";
		reg = <0>;
		spi-max-frequency = <1000000>;
		duplex = <0>;
        frame-format = <0>;
		status = "okay";
	};
};
