&zephyr_udc0 {
	cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
		label = "Zephyr USB CDC-ACM";
	};
};

/ {
	aliases {
        led1 = &user_led;
    };

    leds {
        compatible = "gpio-leds";
        user_led: external_led {
            gpios = <&gpio1 25 GPIO_ACTIVE_HIGH>;
            label = "External LED on pin 23";
        };
    };
};